# Inner Depth AI organizer: server-side configuration.
# Copy to .env.local for the local dev server (tools/inner-depth-dev-server.mjs), or set these as
# Environment Variables in the Vercel project. NEVER commit .env.local. NEVER put any of these in docs/.

# --- Required -------------------------------------------------------------------------------
# OpenRouter API key. Create it at https://openrouter.ai/settings/keys and give it a hard credit limit.
OPENROUTER_API_KEY=
# Master switch. Anything but true/1/yes/on keeps the AI organizer off (the local organizer still works).
INNER_DEPTH_AI_ENABLED=true
# Facilitator access codes, comma separated, "label:secret" (12+ chars) or "label:sha256:<hex of secret>".
# Generate one:  node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
# Hash one:      node -e "console.log('sha256:'+require('crypto').createHash('sha256').update(process.argv[1]).digest('hex'))" <secret>
INNER_DEPTH_FACILITATOR_KEYS=

# --- Routing ---------------------------------------------------------------------------------
# Default intelligence mode offered to facilitators: adaptive | economy | deep | manual
INNER_DEPTH_ROUTING_MODE=adaptive
# Within a tier: pick from the registry in order ("registry") or let OpenRouter's auto router choose
# among the tier's approved models ("openrouter-auto").
INNER_DEPTH_TIER_SELECTOR=registry
# Optional overrides of the per-tier candidate order. Ids must be approved and eligible in
# server/inner-depth/models.json; unknown or ineligible ids are ignored.
INNER_DEPTH_FAST_MODELS=
INNER_DEPTH_BALANCED_MODELS=
INNER_DEPTH_ADVANCED_MODELS=
# First attempt plus bounded retry/escalation (1-3).
INNER_DEPTH_MAX_ATTEMPTS=2
INNER_DEPTH_ALLOW_ESCALATION=true

# --- Privacy ---------------------------------------------------------------------------------
# Every request carries provider: { zdr: true, data_collection: "deny", require_parameters: true }.
# Models whose only private endpoints are "Safety Retention" (e.g. Gemini on Google) are excluded
# unless you accept that tier here. Read the OpenRouter ZDR documentation before changing this.
INNER_DEPTH_ALLOW_SAFETY_RETENTION=false

# --- Cost controls (USD) ---------------------------------------------------------------------
INNER_DEPTH_MAX_SESSION_COST_USD=1.00
INNER_DEPTH_MAX_REQUESTS_PER_SESSION=20
INNER_DEPTH_MAX_REQUEST_COST_USD=0.50
INNER_DEPTH_DAILY_COST_CAP_USD=25
INNER_DEPTH_MAX_OUTPUT_TOKENS=8000
INNER_DEPTH_REQUEST_TIMEOUT_MS=75000

# --- Abuse limits ----------------------------------------------------------------------------
INNER_DEPTH_RATE_LIMIT_PER_MINUTE=8
INNER_DEPTH_RATE_LIMIT_PER_DAY=120
INNER_DEPTH_DAILY_REQUEST_CAP=400
INNER_DEPTH_MAX_BODY_BYTES=98304
# Comma-separated origins allowed besides same-origin, e.g. https://yousseft2002.github.io,capacitor://localhost,https://localhost
INNER_DEPTH_ALLOWED_ORIGINS=
# Optional shared counter store so limits hold across serverless instances (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Misc ------------------------------------------------------------------------------------
# Shown to OpenRouter as the app URL (HTTP-Referer) so usage appears under this app on their dashboard.
INNER_DEPTH_APP_URL=
# "mock" returns deterministic stand-in output for tests. Refused when VERCEL_ENV/NODE_ENV is production.
INNER_DEPTH_AI_MODE=live
# "silent" turns off the (content-free) structured logs.
INNER_DEPTH_LOG=
